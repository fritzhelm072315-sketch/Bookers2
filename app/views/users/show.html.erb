<%= render 'books/book', books: @books %>

<div class="col-md-8 offset-md-1 mt-3"">
  <h3>Books</h3>
  <table class="table table-hover table-inverse">
    <thead>
    <tr>
      <th></th>
      <th>Title</th>
      <th>Opinion</th>
      <th colspan="3"></th>
    </tr>
    </thead>
    <% @books.each do |book| %>
      <tbody>
        <tr>
          <th>
            <%= link_to user_path(book) do %>
              <%= image_tag book.user.get_profile_image(100,100) %>
            <% end %>
          </th>
          <th>
            <%= link_to book_path(book) do %>
              <%= book.title %>
            <% end %>
          </th>
          <th>
            <%= book.body %>
          </th>
          <th></th>
        </tr>
      </tbody>
    <% end %>
  </table>
</div>
