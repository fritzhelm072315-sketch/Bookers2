<%= render 'book', books: @books %>

<div class="col-md-8 offset-md-1 mt-3"">
  <h3>Book detail</h3>
  <table class="table table-hover table-inverse">
      <tbody>
        <tr>
          <th>
              <%= link_to user_path(@book.user) do %>
                <%= image_tag @book.user.get_profile_image(100, 100) %><br>
                <%= @book.user.name %>
              <% end %>
          </th>
          <th>
            <%= link_to book_path do %>
              <%= @book.title %>
            <% end %>
          </th>
          <th>
            <%= @book.body %>
          </th>
          <th>
            <% if @book.user == Current.user %>
              <%= link_to "Edit", edit_book_path(@book.id), class: "btn btn-success btn-sm" %>
            <% end %>
          </th>
          <th>
            <% if @book.user == Current.user %>
              <%= link_to "Destroy", book_path, class: "btn btn-danger btn-sm", data: { turbo_method: :delete, turbo_confirm: "reaiiy" } %>
            <% end %>
          </th>
        </tr>
      </tbody>

  </table>
</div>