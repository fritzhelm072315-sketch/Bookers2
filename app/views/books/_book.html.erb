<div class="container">
  <div class="row">
    <% if @book.errors.any? %>
      <div id="error_explanation">
        <h2><%= pluralize(@book.errors.count, "error") %> prohibited this obj from being saved:</h2>
        <ul>
          <% @book.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>
</div>

  <div class="container px-5 px-sm-0">
    <div class="row">
      <div class="col-md-3">
        <div class="mt-3">
          <h3>User info</h3>
          
          <% if @user.id == Current.user.id %>
            <% if @user.profile_image.attached? %>
              <%= image_tag @user.get_profile_image(100,100) %>
            <% else %>
              <%= image_tag 'no_image.jpg', size: "100x100" %>
            <% end %>
            <table class="table">
              <tr></tr>
              <tr>
                <th><label class="form-label fw-bold">name</label></th>
                <th><label class="form-label fw-bold"><%= @user.name %></label></th>
              </tr>
              <tr>
                <th><label class="form-label fw-bold">Introduction</label></th>
                <th><label class="form-label fw-bold"><%= @user.introduction %></label></th>
              </tr>
            </table>
            <div class="row">
              <%= link_to edit_user_path(@user.id), class:"btn btn-outline-secondary btn-block edit_user_id" do %>
                <i class="fa-solid fa-user-gear"></i>
              <% end %>
            </div>

          <% else %>
            <% if @user.profile_image.attached? %>
              <%= image_tag @user.get_profile_image(100,100) %>
            <% else %>
              <%= image_tag 'no_image.jpg', size: "100x100" %>
            <% end %>
            <table class="table">
              <tr></tr>
              <tr>
                <th><label class="form-label fw-bold">name</label></th>
                <th><label class="form-label fw-bold"><%= @user.name %></label></th>
              </tr>
              <tr>
                <th><label class="form-label fw-bold">Introduction</label></th>
                <th><label class="form-label fw-bold"><%= @user.introduction %></label></th>
              </tr>
            </table>
            <div class="row">
              <%= link_to edit_user_path(@user.id), class:"btn btn-outline-secondary btn-block edit_user_id" do %>
                <i class="fa-solid fa-user-gear"></i>
              <% end %>
            </div>
          <% end %>

        </div>

        <%= form_with model: @book, url:books_path(), method: :post do |f| %>
          <div class="mt-3">
            <div class="row">
              <h3>New book</h3>
              <label class="form-label fw-bold">Title</label>
              <%= f.text_field :title, class: "form-control" %>
            </div>
            <div>
              <label class="form-label fw-bold">Opinion</label>
              <%= f.text_field :body, class: "form-control" %>
            </div>
            <div>
              <%= f.submit "Create Book", class: "btn btn-sm btn-success" %>
            </div>
          <div>
        <% end %>
      </div>
    </div>
  
</div>



