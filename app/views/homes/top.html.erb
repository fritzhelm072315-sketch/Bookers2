<main>
  <p id="notice"></p>
  <div class="container">
    <div class="row">
      <div class="mx-auto col-11 col-sm-10 col-lg-8 col-xl-6">
        <h1>welcome to 
          <i class="fa-solid fa-book"></i>
          <strong>Bookers</strong>
          !!
        </h1>
        <p>In  
          <i class="fa-solid fa-book"></i>
          <strong>Bookers</strong>, 
        </p>
        <p>you can share and exchange  your opinions , inpressions , and emotions</p>
        <p> about various books!</p>
        <div class="btn-wrapper col-10 mx-auto">
          <div class="row p-3">
            <%= link_to new_session_path, class: "btn btn-info btn-sm" do %>Log in
            <% end %>
          </div>
          <div class="row p-3">
            <%= link_to new_user_path, class: "btn btn-success btn-sm" do %>Sign up
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>
